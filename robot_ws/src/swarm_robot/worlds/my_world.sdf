
<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">

    <!-- ====================== -->
    <!-- PHYSICS -->
    <!-- ====================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ====================== -->
    <!-- PLUGINS -->
    <!-- ====================== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin filename="libgz-sim-sensors-system.so"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- ====================== -->
    <!-- SUN -->
    <!-- ====================== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- ====================== -->
    <!-- LANTAI HIJAU 40x20m -->
    <!-- ====================== -->
    <model name="green_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="floor_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>9.0 5.0 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>9.0 5.0 0.02</size>
            </box>
          </geometry>
          <material>
            <!-- Hijau lapangan -->
            <ambient>0.13 0.55 0.13 1</ambient>
            <diffuse>0.13 0.55 0.13 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ====================== -->
    <!-- DINDING DEPAN (+X) -->
    <!-- ====================== -->
    <model name="wall_front">
      <static>true</static>
      <pose>4.5 0 0.5 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
          <material>
            <!-- Hijau gelap -->
            <ambient>0.0 0.25 0.0 1</ambient>
            <diffuse>0.0 0.25 0.0 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ====================== -->
    <!-- DINDING BELAKANG (-X) -->
    <!-- ====================== -->
    <model name="wall_back">
      <static>true</static>
      <pose>-4.5 0 0.5 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.25 0.0 1</ambient>
            <diffuse>0.0 0.25 0.0 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ====================== -->
    <!-- DINDING KIRI (+Y) -->
    <!-- ====================== -->
    <model name="wall_left">
      <static>true</static>
      <pose>0 2.5 0.5 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>9.0 0.1 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>9.0 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.25 0.0 1</ambient>
            <diffuse>0.0 0.25 0.0 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ====================== -->
    <!-- DINDING KANAN (-Y) -->
    <!-- ====================== -->
    <model name="wall_right">
      <static>true</static>
      <pose>0 -2.5 0.5 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>9.0 0.1 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>9.0 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.25 0.0 1</ambient>
            <diffuse>0.0 0.25 0.0 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ====================== -->
    <!--    KAMERA EKSTERNAL    -->
    <!-- ====================== -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 5.0 0 1.5708 0</pose>

      <link name="camera_link">

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>

        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000167</ixx>
            <iyy>0.000167</iyy>
            <izz>0.000167</izz>
          </inertia>
        </inertial>

        <sensor name="overhead_camera_sensor" type="camera">

          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/overhead_camera/image_raw</topic>

          <camera>
            <horizontal_fov>2.0</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50.0</far>
            </clip>
          </camera>

        </sensor>

      </link>
    </model>


    <!-- ====================== -->
    <!-- TARGET ArUco (bisa digeser manual di Gazebo) -->
    <!-- ====================== -->
    <model name="aruco_target_v3">
      <static>true</static>
      <pose>2 1 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 0.02</size></box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file:///home/selvia/robot_ws/src/swarm_robot/meshes/aruco/target_marker.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>


    <!-- ====================== -->
    <!-- CORNER MARKER TL (ArUco ID=3) -->
    <!-- ====================== -->
    <model name="corner_TL">
      <static>true</static>
      <pose>-4.2 2.2 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 0.02</size></box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file:///home/selvia/robot_ws/src/swarm_robot/meshes/aruco/aruco3.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================== -->
    <!-- CORNER MARKER TR (ArUco ID=4) -->
    <!-- ====================== -->
    <model name="corner_TR">
      <static>true</static>
      <pose>4.2 2.2 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 0.02</size></box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file:///home/selvia/robot_ws/src/swarm_robot/meshes/aruco/aruco4.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================== -->
    <!-- CORNER MARKER BR (ArUco ID=5) -->
    <!-- ====================== -->
    <model name="corner_BR">
      <static>true</static>
      <pose>4.2 -2.2 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 0.02</size></box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file:///home/selvia/robot_ws/src/swarm_robot/meshes/aruco/aruco5.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================== -->
    <!-- CORNER MARKER BL (ArUco ID=6) -->
    <!-- ====================== -->
    <model name="corner_BL">
      <static>true</static>
      <pose>-4.2 -2.2 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.3 0.3 0.02</size></box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>file:///home/selvia/robot_ws/src/swarm_robot/meshes/aruco/aruco6.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
